{
  "name": "@ancplua/typespec-emit-ts-types",
  "version": "0.1.0",
  "description": "ANcpLua TypeSpec emitter for TypeScript types (branded scalars + interfaces)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "dist/index.js",
  "tspMain": "lib/main.tsp",
  "exports": {
    ".": {
      "typespec": "./lib/main.tsp",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p ."
  },
  "peerDependencies": {
    "@typespec/compiler": "^1.17.0",
    "@typespec/http": "^1.17.0",
    "@typespec/openapi": "^1.17.0"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@typespec/compiler": "1.17.0",
    "@typespec/http": "1.17.0",
    "typescript": "7.0.2"
  }
}
