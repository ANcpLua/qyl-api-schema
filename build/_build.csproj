<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace></RootNamespace>

    <!-- Fallout injects parameter fields through reflection. -->
    <NoWarn>CS0649;CS0169</NoWarn>

    <FalloutRootDirectory>..</FalloutRootDirectory>
    <FalloutScriptDirectory>..</FalloutScriptDirectory>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Fallout.Common" Version="10.4.0" />
  </ItemGroup>

  <!-- The .NET SDK's NuGet (7.9.0), not the 6.14.3 Fallout.Common 10.4.0 brings; Fallout's own
       build moved the same way (Fallout-build/Fallout#677). -->
  <ItemGroup>
    <PackageReference Include="NuGet.Packaging" Version="7.9.0" PrivateAssets="all" />
  </ItemGroup>

  <!-- NuGet.Packaging and MSBuild bring System.Security.Cryptography.Pkcs and .Xml 10.0.10
       (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7, GHSA-7hqp-7c5m-4vq6, GHSA-c399-9853-6jmj,
       GHSA-r955-8q5j-3h83; 2026-10-13); 10.0.13 is the patched build. -->
  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" PrivateAssets="all" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.13" PrivateAssets="all" />
  </ItemGroup>

</Project>
