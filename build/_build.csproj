<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace></RootNamespace>

    <!-- Fallout injects parameter fields through reflection. -->
    <NoWarn>CS0649;CS0169</NoWarn>

    <FalloutRootDirectory>..</FalloutRootDirectory>
    <FalloutScriptDirectory>..</FalloutScriptDirectory>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Fallout.Common" Version="10.4.0" />
  </ItemGroup>

  <!-- The .NET SDK's NuGet (7.9.0), not the 6.14.3 Fallout.Common 10.4.0 brings; Fallout's own
       build moved the same way (Fallout-build/Fallout#677). -->
  <ItemGroup>
    <PackageReference Include="NuGet.Packaging" Version="7.9.0" PrivateAssets="all" />
  </ItemGroup>

</Project>
